# Copy to .env.local and fill in real values. Never commit the filled copy.
#
# Only VITE_-prefixed variables reach the browser. Anything secret must live in
# a Supabase edge-function secret instead (`supabase secrets set NAME=value`),
# because a VITE_ variable is compiled into the JavaScript bundle and is
# readable by anyone who opens developer tools.

# ── Safe in the browser ────────────────────────────────────────────
# The anon/publishable key is designed to be public. It is only safe because
# Row Level Security is enabled on every table — if RLS is ever disabled on a
# table, this key exposes that table to the internet.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Weather. Open-Meteo needs no key; these remain only for the legacy provider.
VITE_OPENWEATHER_API_KEY=
VITE_OPENWEATHER_API_KEY_FALLBACK=

# Optional: enables client-side AI (crop scanning and advisory chat) without
# deploying the edge functions. Convenient for a demo, but the key ships inside
# the bundle — prefer the edge-function path for a public launch.
VITE_GEMINI_API_KEY=

# ── Never put these in a VITE_ variable ────────────────────────────
# Set them as edge-function secrets, not here:
#   GEMINI_API_KEY           crop-vision, translate
#   NVIDIA_API_KEY           kisan-ai-chat
#   DATAGOV_API_KEY          mandi-prices
#   RESEND_API_KEY           login-2fa
#   RESEND_WEBHOOK_SECRET    resend-webhook
#   SUPABASE_SERVICE_ROLE_KEY   provided automatically to functions
